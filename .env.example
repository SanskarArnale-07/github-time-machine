# Copy this file to .env.local and fill in the values.
# cp .env.example .env.local

# ── Supabase ───────────────────────────────────────────────────────────────
# Required for authentication and session management.
# Get these from your Supabase project settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── GitHub ─────────────────────────────────────────────────────────────────
# Server-side only. Never exposed to the browser or the extension.
# Used by /api/github/public/[username] to raise the GitHub API rate limit
# from 60 req/hr (unauthenticated) to 5,000 req/hr (authenticated).
#
# Minimum required scope: read:user
# Generate a classic PAT at: https://github.com/settings/tokens
GITHUB_TOKEN=
